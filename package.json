{
  "name": "hoc-cung-nhau",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hcn/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "echo 'E2E chưa có ở mốc M0' && exit 1",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:types": "kysely-codegen --out-file packages/db/src/schema.ts --dialect postgres",
    "db:seed:curriculum": "node scripts/seed-not-yet.mjs curriculum",
    "db:seed:test": "node scripts/seed-not-yet.mjs test",
    "openapi:check": "node scripts/openapi-check.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.27.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "kysely-codegen": "^0.18.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
